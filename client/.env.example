# MuseForge client (Next.js) — copy to client/.env.local

# Backend API base URL (no trailing slash).
#
# Read by lib/apiBase.js, which every browser fetch goes through. Next.js bakes
# NEXT_PUBLIC_* into the bundle AT BUILD TIME, so changing it on the host is not
# enough — the frontend has to be rebuilt or the old value keeps shipping.
#
# That is not a hypothetical: the deployed bundle went on pointing at a
# retired Render backend after the API moved to Coolify, so every generate,
# estimate and credit call answered 503 while the site itself looked alive
# (the dashboard reads Supabase directly, not the API).
#
# Production: https://api2.museforge.studio
NEXT_PUBLIC_API_URL=http://localhost:8000

# Canonical public origin (no trailing slash). Drives canonical URLs, hreflang,
# sitemap.xml, robots.txt and the www -> apex redirect. Must be set in prod.
# The live site is museforge.studio; this said museforge.ai, which is a
# different domain and would put the wrong host in every canonical tag.
NEXT_PUBLIC_SITE_URL=https://museforge.studio

# Search engine ownership verification — paste the token, not the whole tag.
# Leave empty to omit the meta tag entirely.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Supabase (browser-safe anon key only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stripe publishable key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# LiveCounter stays fully hidden until total_completed reaches this number
# (weak social proof below the threshold). Default in code is 50 if unset.
NEXT_PUBLIC_COUNTER_THRESHOLD=100
