# MuseForge client (Next.js) — copy to client/.env.local

# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Canonical public origin (no trailing slash). Drives canonical URLs, hreflang,
# sitemap.xml, robots.txt and the www -> apex redirect. Must be set in prod.
NEXT_PUBLIC_SITE_URL=https://museforge.ai

# Search engine ownership verification — paste the token, not the whole tag.
# Leave empty to omit the meta tag entirely.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Supabase (browser-safe anon key only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stripe publishable key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# LiveCounter stays fully hidden until total_completed reaches this number
# (weak social proof below the threshold). Default in code is 50 if unset.
NEXT_PUBLIC_COUNTER_THRESHOLD=100
