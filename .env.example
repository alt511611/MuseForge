# MuseForge — tüm ortam değişkenleri
#
# API anahtarları boş bırakılırsa DEMO modu etkin olur.

# ── AI / Medya sağlayıcılar ───────────────────────────────────────────────────
MUAPI_KEY=
ANTHROPIC_API_KEY=
MUSEFORGE_DEMO=                         # "1" / "true" ile demo modu zorla
# Pro/Standard artık ENDPOINT ile seçiliyor (payload içinde "mode" alanı yok).
# Plan eşlemesi: pro → PRO endpoint, diğerleri → STANDARD (endpoint_for_plan).
# MUAPI_VIDEO_MODEL_STANDARD=kling-v3.0-standard-image-to-video
# MUAPI_VIDEO_MODEL_PRO=kling-v3.0-pro-image-to-video
#
# Çekim tipine göre model yönlendirme (tools/video_model_router.py).
# Boş bırakılırsa davranış aynen bugünkü gibi: her çekim plan endpoint'ine
# gider. Bir profil doldurulduğunda o profildeki çekimler ÖNCE bu modeli
# dener; reddedilirse (404/422) sırayla plan endpoint'ine ve STANDARD'a
# düşer -- yani yanlış bir slug işi düşürmez, sadece yavaşlatır.
# Slug'ı MuAPI playground'da doğruladıktan sonra doldurun.
#
# Payload modele göre daraltılır (tools/video_model_router._ENDPOINT_FIELDS):
# tanımadığımız bir slug'a yalnız prompt + image_url + duration gider, çünkü
# MuAPI bildirilmemiş alanı 422 ile reddeder ve zincir bunu "bu endpoint yok"
# diye okuyup sessizce Standard'a düşer. Yeni bir model eklerken şemasını
# playground'dan o haritaya işleyin.
#
# Playground'da doğrulanmış adaylar (üretim başına maliyet):
#   veo3.1-fast-image-to-video          $0.60  — süre SABİT 8 sn
#   kling-v3-turbo-pro-image-to-video   $1.12  — 3-15 sn
#   seedance-2.5-image-to-video         $2.72  — 4-30 sn, marjı yer
#   minimax-hailuo-2.3-pro-i2v          $0.63  — süre alanı YOK
# Sabit/süresiz modeller gerilime göre saniye dağıtımını bozar
# (interfaces/second_budget); bunu bilerek seçin.
#
# FİYATLAMA BİÇİMİ, seçtiğiniz sluga göre değişir ve bütçe sabitlerini
# doğrudan etkiler. Varsayılan kling-v3.0-standard/pro-image-to-video
# ÜRETİM BAŞINA $0.72 alır — klip 3 saniye de olsa 15 saniye de. Bu yüzden
# SECONDS_PER_CREDIT=10 operatöre hiçbir şeye mal olmadan müşteriye %25 daha
# uzun film verir. Aynı ailedeki *-omni-* uçları ise SANİYE BAŞINA ücretlidir
# ($0.084/sn, resmî Kling fiyatının aynısı): oraya geçerseniz her saniye
# yeniden para demektir ve second_budget sabitleri yeniden tartışılmalıdır
# (tests/test_pricing_coherence.py bu varsayımı kilitler ve omni sluglarında
# kırmızıya döner).
# MUAPI_VIDEO_MODEL_ACTION=          # kovalamaca, kavga, hızlı hareket
# MUAPI_VIDEO_MODEL_DIALOGUE=        # konuşan yüzler, lip sync öncesi çekimler
# MUAPI_VIDEO_MODEL_ESTABLISHING=    # boş mekân, manzara, insansız insert
# Optional LLM (script/storyboard) model override (default claude-sonnet-4-6)
# MUAPI_LLM_MODEL=claude-sonnet-4-6
# Optional character-reference image model override (default flux-pulid,
# confirmed working -- do not change unless testing an alternative like
# flux-kontext-dev-i2i, which uses a different payload schema handled
# automatically in muapi_image_generator.py)
# MUAPI_KONTEXT_MODEL=flux-pulid

# Alternative video-generation provider (default "muapi", unchanged). Set
# to "falai" for Kling O3 Pro image-to-video, or "falai_reference" for
# Kling O3 Pro reference-to-video (one-step character consistency).
# Requires FAL_KEY.
# MUSEFORGE_VIDEO_PROVIDER=falai
# MUSEFORGE_VIDEO_PROVIDER=falai_reference
# FAL_KEY=

# Optional image provider (default "muapi"). Set to "falai" for
# fal-ai/flux-pro/v1.1 + fal-ai/flux-pro/kontext. Requires FAL_KEY.
# MUSEFORGE_IMAGE_PROVIDER=falai

# Optional music provider (default "muapi"). Set to "falai" for
# beatoven/music-generation. Requires FAL_KEY.
# MUSEFORGE_MUSIC_PROVIDER=falai

# ── Dudak senkronu ────────────────────────────────────────────────────────────
# Konuşan her sahne için ek ücretli çağrı; bu yüzden opt-in.
# MUSEFORGE_LIPSYNC_ENABLED=1
#
# Sağlayıcı: varsayılan "muapi" (sync-lipsync) — FAL_KEY gerekmez, tüm boru
# hattı tek sağlayıcıda kalır. "falai" fal.ai Sync Lipsync'e döner.
#
# ÖNEMLİ: MuAPI ucu `sync_mode` alanını dışarı açmıyor. Sağlayıcının kendi
# varsayılanı (cut_off) VİDEOYU sesin boyuna kırpar; bu, kısa bir replikle
# sahnenin sessizce kısalması ve kredi başına sabit saniye bütçesinin bozulması
# demektir. Boru hattı bu yüzden dönen klibin süresini ölçüp kısaysa reddediyor
# (idea2video._lipsync_scenes) — fal yolunda ise sync_mode=silence ile önlenir.
# MUSEFORGE_LIPSYNC_PROVIDER=falai
# MUAPI_LIPSYNC_MODEL=sync-lipsync

# Crossfade transitions between scenes (default off -- moviepy's heavier
# "compose" mode uses more memory than the default ffmpeg stream-copy path).
# MUSEFORGE_SCENE_TRANSITIONS=1

# Karakter kimlik referansı zincirleme (varsayılan KAPALI). Kapalıyken her
# sahne kilitli portreye tekrar bağlanır, böylece kimlik kayması sahneden
# sahneye birikmez. Açıldığında bir önceki sahnenin üretilmiş karesi referans
# olur (kıyafet/poz sürekliliği daha iyi, kimlik kayması riski daha yüksek).
# MUSEFORGE_DYNAMIC_REFERENCE=1

# Renk derecelendirmesi yönetmen stilinden gelir (DirectorStyle.color_grade ->
# interfaces/color_grade.py): Noir Mystery siyah-beyaz, Anime Expressive canlı,
# Slow Cinematic soluk teal-turuncu vb. Her preset kendi yoğunluğunu taşır.
# Bu değişken TÜM presetlerin yoğunluğunu global olarak ezer, 0..1 arası.
# 0 = derecelendirme yok, 1 = preset tam güçte. Normalde ayarlamaya gerek yok.
# MUSEFORGE_GRADE_STRENGTH=0.8

# Çıkış encode kalitesi. Bitmiş drama yolda birkaç kez yeniden encode ediliyor
# (renk, ses miksi, altyazı, filigran, en-boy dışa aktarım) ve kayıp birikiyor.
# CRF düşük = daha kaliteli + daha büyük dosya. Varsayılan 18 (görsel olarak
# neredeyse kayıpsız); ffmpeg'in çıplak varsayılanı 23 idi.
# MUSEFORGE_VIDEO_CRF=18
# MUSEFORGE_VIDEO_PRESET=medium

# Kare (frame) çözünürlüğünü elle ezmek için. Varsayılanlar
# tools/muapi_image_generator.py ASPECT_RATIO_MAP içinde (~1.3MP).
# Endpoint'iniz kaldırıyorsa 16:9 için 1920x1080 denenebilir.
# MUSEFORGE_IMAGE_WIDTH=1920
# MUSEFORGE_IMAGE_HEIGHT=1080

# Kling'in kendi ses üretimi. Varsayılan KAPALI: montajda concat "-an" ile
# sesi zaten atıyor ve üzerine gerçek müzik/diyalog biniyor, yani üretilen ses
# hiçbir zaman duyulmuyordu — sadece süre ve kredi harcıyordu.
# MUSEFORGE_KLING_NATIVE_AUDIO=1

# Aynı anda kaç sahne render edilir (varsayılan 3). Sahne başına Kling çağrısı
# 1-3+ dakika sürer; paralellik duvar saati süresini parti sayısına indirir
# (5 sahne / 3 eşzamanlılık ≈ 2 sahne-süresi). Karakter kilidi bozulmaz:
# her sahne kilitli portreye bağlanır, sıra önemsizdir.
# MUSEFORGE_DYNAMIC_REFERENCE=1 açıksa otomatik 1'e düşer (zincir sıra ister).
# MUSEFORGE_SCENE_CONCURRENCY=3

# KREDİ BAŞINA SANİYE — sağlayıcı saniye başına faturalıyor, ürün sahne
# başına kredi satıyor. Bu sabit ikisini birbirine bağlar: bir drama
# (sahne x bu değer) saniyelik SABİT bütçe alır, gerilim yalnızca bu toplamı
# DAĞITIR. Böylece iş maliyeti kredi çekilmeden önce kesinleşir ve brüt marj
# hikayeye göre oynamaz. Kod: server/interfaces/second_budget.py
# Düşürmek = saniye başına zam, yükseltmek = indirim. İş kararıdır.
# (varsayılan 8.0 — önceki serbest davranışın ölçülen ortalaması, gelir-nötr)

# Master finishing (varsayılan AÇIK): siyahtan açılış / siyaha kapanış fade'i
# + ses varsa EBU R128 loudness normalizasyonu (-14 LUFS, yayın standardı).
# Tek encode geçişi; kapatmak için:
# MUSEFORGE_FINISHING=0

# Teslim çözünürlüğü. İstenen en-boy oranı (16:9 / 9:16 / 1:1) her zaman
# birebir uygulanır; çözünürlük ise üretilen görüntünün gerçek boyutunu aşmaz
# (tavan: 1920x1080 / 1080x1920 / 1080x1080). Dağıtım kanalı birebir 1080x1920
# dosya şart koşuyorsa, upscale pahasına:
# MUSEFORGE_EXACT_RESOLUTION=1

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key   # sadece backend
SUPABASE_ANON_KEY=your-anon-key              # backend referansı

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Ürün/fiyat ID'leri (Stripe Dashboard → Products'tan alın)
# Kredi miktarları KOD tarafından belirlenir, bu yorumlardan değil:
#   abonelikler → server/stripe_integration.py PLAN_CREDITS
#   paketler    → server/stripe_integration.py CREDIT_PACKAGES
# Aşağıdaki rakamlar o kaynakla eşleşir; Stripe fiyatını değiştirirsen
# kodu da güncelle, yoksa müşteri ödediğinden farklı kredi alır.
STRIPE_PRICE_CREATOR=price_creator_id_here   # $59/mo — 16 credits
STRIPE_PRICE_PRO=price_pro_id_here           # $129/mo — 36 credits
# Yıllık (%10 indirim) — fiyat sayfasının varsayılan olarak gösterdiği seçenek.
# Bunlar TANIMLI DEĞİLSE yıllık checkout 400 döner; aylık fiyata sessizce
# düşmez (kullanıcı "yıllık" seçtiyse aylık döngüye alınması bir hata olur).
# Yıllık Price'lar Stripe'ta yearly recurring olarak, aşağıdaki toplamlarla
# oluşturulmalı — kredi tahsisi tüm yılı peşin verir (12 x aylık, 365 gün).
STRIPE_PRICE_CREATOR_ANNUAL=price_creator_annual_id  # $637/yıl (≈$53/ay) — 192 kredi
STRIPE_PRICE_PRO_ANNUAL=price_pro_annual_id          # $1393/yıl (≈$116/ay) — 432 kredi
# One-time credit packages (mode=payment, not subscription)
STRIPE_PRICE_CREDITS_SMALL=price_credits_small_id    # $19 — 4 credits
STRIPE_PRICE_CREDITS_MEDIUM=price_credits_medium_id  # $49 — 12 credits
STRIPE_PRICE_CREDITS_LARGE=price_credits_large_id    # $99 — 26 credits

# ── Sunucu ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MUSEFORGE_JOBS_DIR=/tmp/museforge_jobs
# Wall-clock seconds per sequential scene (frame + video). Default 100.
MUSEFORGE_SECONDS_PER_SCENE=100
# Optional estimate add-ons (defaults shown):
# MUSEFORGE_ESTIMATE_BASE_SECONDS=90
# MUSEFORGE_ESTIMATE_MUSIC_SECONDS=45
# MUSEFORGE_ESTIMATE_DIALOGUE_PER_SCENE=20
# MUSEFORGE_WAIT_WARNING_MINUTES=15

# ── Stale job reaper (backend) ───────────────────────────────────────────────
# queued/running jobs older than this many minutes (by updated_at) are marked
# failed as "Orphaned (server restart or timeout)". Must exceed the pipeline
# hard timeout. Default 150 (Pro 24-scene jobs can run 30–60+ min).
MUSEFORGE_STALE_JOB_TIMEOUT_MINUTES=150
# Hard timeout for a single pipeline.run() (seconds). Default 7200 = 2 hours.
MUSEFORGE_PIPELINE_HARD_TIMEOUT=7200
# Optional Claude-vision QA after each frame (character + setting). Default off.
# MUSEFORGE_CHARACTER_QA_ENABLED=1
# Optional character dialogue via MuAPI ElevenLabs text-to-dialogue. Default off.
# Açıkken Pro planda /api/health dialogue_available=true döner ve UI'da
# diyalog anahtarı görünür (sahne başına +1 kredi).
# MUSEFORGE_DIALOGUE_ENABLED=1
# MUAPI_VOICE_MODEL=elevenlabs-text-to-dialogue-v3
# Sağlayıcı geçerli voice_id listesini yayımlamıyor; yanlış değer submit'te
# değil, sahneler üretildikten sonra "Invalid voice parameter" ile patlıyor.
# Bu yüzden kod üç yazımı (ham ID / "George - Warm" / "George") sırayla dener
# ve kabul edileni process boyunca hatırlar — normalde bir şey yazmana gerek
# yok. Aşağıdakiler sadece sağlayıcı tamamen başka bir değer isterse:
# cd server && MUAPI_KEY=... python -m tools.probe_dialogue_voices
# MUSEFORGE_VOICE_IDS=JBFqnCBsd6RMkjVDRZzb,EXAVITQu4vr4xnSDxMaL
# MUSEFORGE_FEMALE_VOICE_IDS=EXAVITQu4vr4xnSDxMaL,XB0fDUnXU5powFXDhCwa
# MUSEFORGE_MALE_VOICE_IDS=JBFqnCBsd6RMkjVDRZzb,nPczCjzI2devNBz1zQrb
#
# ÖNERİLEN: sesi doğrudan ElevenLabs'tan al.
# MuAPI'nin bu sarmalayıcısı KENDİ model sayfasının yayımladığı sesleri
# reddediyor — teslim edilen loglarda tek bir katalog sesi için ID'si
# (XB0fDUnXU5powFXDhCwa), yayımlanmış etiketi ("Charlotte - Clear") ve adı
# ("Charlotte") üçü de "Invalid voice parameter" aldı. Kadro seçmekle
# çözülmez. Doğrudan bağlanınca üç şey kazanılır: GET /v1/voices ile geçerli
# sesler SORULABİLİR; /text-to-dialogue/with-timestamps replik başına gerçek
# başlangıç/bitiş döndürür (altyazılar tahmin olmaktan çıkar); ve bu iş şekli
# için ~6 kat ucuzdur (MuAPI üretim başına $0.10, ElevenLabs karakter başına
# ~1 kredi — 250 karakterlik bir drama $0.30 yerine ~$0.05).
# Video için bu geçerli DEĞİL: orada düz üretim ücreti saniyelik fiyatı yener.
# MUSEFORGE_VOICE_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=
# ELEVENLABS_DIALOGUE_MODEL=eleven_v3     # text-to-dialogue destekleyen model
# ELEVENLABS_VOICE_IDS=                   # boşsa yerleşik kadro
# ELEVENLABS_FEMALE_VOICE_IDS=
# ELEVENLABS_MALE_VOICE_IDS=

# ── Oyunculuk, ritim ve altyazı stili ───────────────────────────────────────
#
# Bu üçü mikro-dramanın "yapay" görünmesinin üç ayrı sebebine karşılık gelir:
# donuk yüz, tek açıda duran uzun plan, ve konuşmayı takip etmeyen altyazı.
# Duygu haritasının kendisi (interfaces/acting) her zaman açıktır ve bedavadır
# — aşağıdakiler yalnızca PARA ya da BİÇEM kararı gerektiren kısımlar.

# Uç kare ile oyunculuk. Açıkken her çekimin başlangıç karesi bir düzenleme
# modeliyle "duygunun zirvesi" haline getirilir ve Kling'e son kare olarak
# verilir; model iki yüz arasındaki değişimi FİZİKSEL olarak oynamak zorunda
# kalır (gözyaşının süzülmesi, çenenin sıkılması) — istemekle oynatmak
# arasındaki fark budur.
#
# Varsayılan KAPALI, çünkü çekim başına bir görsel üretimi daha ekler
# (~$0.04, sahne başına ~$0.79 maliyette yarım puan marj) ve bir DÜZENLEME
# modeli ister. MUSEFORGE_EDIT_MODEL kimlik modeli (flux-pulid) OLMAMALI:
# kimlik modeli aynı yüzü farklı bir kompozisyonda döndürür, iki farklı
# kompozisyon arasında interpolasyon ise oyunculuk değil warp üretir.
# Her hata fail-open: uç kare üretilemezse çekim tek kareden animasyona döner.
# MUSEFORGE_ACTING_END_FRAME=1
# MUSEFORGE_EDIT_MODEL=flux-kontext-pro-i2i

# Sahne içi kesme (post-cut punch-in). Tek bir üretimden dijital yakınlaşmalar
# kurgulanarak sahneye ritim verilir — sağlayıcıya ek kuruş gitmez, sahnenin
# süresi birebir korunur (kredi–saniye sözü bozulmaz).
# auto (varsayılan) = yönetmen stilinin temposu "fast" ise açık; on/off zorlar.
# auto ayrıca 7 saniyeyi geçen her sahneyi stilden bağımsız keser.
# MUSEFORGE_INTERNAL_CUTS=auto

# Sahne başına ÇEKİM sayısı (gerçek kapsam / plan-karşı plan).
# Varsayılan 1: her sahne tek kadrajlık tek çekim. Bir filmin çekimlerden
# oluşmadığı hissinin ("fotoğraf oynuyor") asıl kaynağı budur — ama bir maliyet
# kararıdır: her ek çekim = bir kare üretimi + bir image-to-video çağrısı daha,
# yani sahne maliyeti 2-3 katına çıkar. Yukarıdaki iç kesme bunun bedava ama
# eksik ikamesi: elimizdeki tek kareye dijital yakınlaşır, ikinci bir açı vermez.
# 1-4 arası; storyboard'a da bu sayı söylenir.
# MUSEFORGE_SHOTS_PER_SCENE=2

# Tepki çekimi (ikinci açı). Açıkken tension >= 8 olan sahneler master'ın
# yanında 2 saniyelik bir yakın plan tepki çekimi alır: master tam bütçesiyle
# ÜRETİLİR (düz fiyat, kısaltmak para kazandırmaz), teslimde baştan 2 saniye
# kırpılır — son kare oyunculuğun indiği yer olduğu için kuyruk korunur.
#
# Maliyet: sahne başına ~$0.34 (veo3.1-lite $0.30 + kare $0.04). Pro planında
# marj %78 → %69 bandına iner; %65 tabanının üstünde kalır ve
# tests/test_pricing_coherence.py bunu doğrular. Tüm dramada değil sadece
# doruk sahnelerde tetiklendiği için tipik bir 3 sahnelik işte 1 sahneyi
# etkiler.
#
# Lipsync açık sahnelerde otomatik devre dışı: dudak senkronu sahne klibinin
# tamamında ağzı sürüyor ve ortasındaki kesmeyi göremiyor.
# MUSEFORGE_REACTION_SHOTS=1
#
# Tepki çekiminin modeli. Varsayılan veo3.1-lite ($0.30 DÜZ, last_image
# destekli). Bunu kling'e çevirmek 2 saniyelik bir yüz için $0.72 ödemek
# demektir — yani ikinci bir açı değil, ikinci bir sahne. "Ucuz" görünen
# turbo/seedance uçları saniyelik faturalandığı için burada daha pahalıdır.
# MUAPI_VIDEO_MODEL_REACTION=ovi-image-to-video

# Konuşmacı adı altyazıda. KAPALI: yayıncılık, konuşmacıyı ancak görüntü
# gösteremiyorsa adlandırır (ekran dışı ses, kalabalık, anlatıcı) — 42
# karakterlik bir satırda "Sal Okafor: " bütçenin dörtte biridir ve izleyiciye
# zaten baktığı şeyi anlatır. İşitme engelliler için altyazı (SDH) üreten bir
# kurulumun ihtiyacı tam tersidir; o yüzden açılabilir.
# MUSEFORGE_SPEAKER_LABELS=1

# Kinetik altyazı (TikTok/Reels biçemi): aynı anda 2-3 kelime, söylenen kelime
# ASS karaoke etiketiyle (\k) yanar, sahnenin "turn" cümlesindeki kelimeler
# büyüyüp vurgu rengine döner. ÖLÇÜLMÜŞ kelime zamanlaması ister; bunu yalnızca
# doğrudan ElevenLabs yolu döndürür (alignment alanı). Başka bir ses
# sağlayıcısıyla sessizce düz altyazıya döner — yanlış kelimede yanan bir
# altyazı, hiç olmamasından daha kötüdür.
# MUSEFORGE_WORD_CAPTIONS=1

# ── Ses tasarımı ve kurgu formülü ───────────────────────────────────────────

# Foley (sahne başına ses yatağı). Kapı, cam, ayak sesi, oda tonu — görüntünün
# çıkardığı ses. Prompt olarak storyboard'un HER çekim için yazdığı ve bugüne
# kadar hiçbir yerin okumadığı `audio_desc` alanı kullanılır.
#
# Maliyet: mmaudio-v2/text-to-audio ile sahne başına $0.01 — sahne maliyetinin
# yaklaşık %1'i. Lisanslı bir .wav kütüphanesi taşımaktan hem ucuz hem bakımsız.
# Başarısız olursa sahne müzik ve diyalogla oynar; foley bir filmin en kolay
# vazgeçebileceği katman.
# MUSEFORGE_FOLEY=1
# MUAPI_SFX_MODEL=mmaudio-v2/text-to-audio   # dikkat: slash'lı, namespace'li slug
#
# NOT: Miks artık ffmpeg'de yapılıyor ve müzik konuşmanın altına DİNAMİK olarak
# giriyor (sidechaincompress) — eskiden replik varsa müzik tüm film boyunca
# sabit %20'ye kısılıyordu. Görüntü bu geçişte yeniden kodlanmıyor (-c:v copy).

# Darbe efektleri: kesme karesinde 1 kare beyaz flaş, 0.22 sn sönümlenen kamera
# sarsıntısı ve 2 pikselllik kromatik sapma. Yalnızca GERÇEK bir kesme varsa
# (tepki çekimi üretilmiş sahnelerde) ve tension=10 iken tetiklenir; kesmesiz
# bir plana konan darbe hiçbir şeyi noktalamaz.
# auto (varsayılan) = kesme + tension 10; on/off zorlar.
# MUSEFORGE_IMPACT=auto

# Kurgusal formül. "micro_drama" senaryocuya farklı bir dramatik eğri yazdırır:
# 1. sahne şokla AÇILIR (tension 8+), sonra düşer, sonra doruk noktasına
# tırmanır ve ÇÖZÜLMEDEN biter (resolution sahnesi yazılmaz, `cliffhanger`
# alanı doldurulur). Ayrıca kurguya cold open ekler: doruk sahnenin son 1.5
# saniyesi filmin en başına konur, ardından "DAHA ÖNCE" kartı gelir — hiçbir
# ek üretim yok, zaten ödenmiş görüntünün erken gösterilmesi.
#
# API isteğinde `narrative_mode` alanıyla iş bazında da seçilebilir.
# MUSEFORGE_NARRATIVE_MODE=micro_drama
# MUSEFORGE_COLD_OPEN=0     # micro_drama modunda cold open'ı kapatmak için

# ── Client (Next.js NEXT_PUBLIC_ = tarayıcıya açık) ─────────────────────────
API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# LiveCounter stays hidden until total_completed reaches this (see client/.env.example)
NEXT_PUBLIC_COUNTER_THRESHOLD=100
