# The configuration production actually runs, minus its secrets.
#
# This replaces render.yaml. Coolify is the only deployment now, and Coolify
# keeps its environment in a database rather than in the repository -- which
# leaves a gap the blueprint used to fill: nothing in version control said what
# the running service is configured to do, and no review could see a flag being
# flipped.
#
# So this file is the record. It is not read by any process at deploy time; it
# is read by a human pasting it into Coolify's developer view (which takes
# exactly this format), and by tests/test_the_shipped_configuration_is_sane.py,
# which fails when a value here contradicts what the code needs.
#
# SECRETS ARE NOT HERE AND MUST NOT BE ADDED. Every key, token and connection
# string lives in Coolify and nowhere else:
#
#     ANTHROPIC_API_KEY   ELEVENLABS_API_KEY   FAL_KEY   MUAPI_KEY
#     SUPABASE_URL   SUPABASE_ANON_KEY   SUPABASE_SERVICE_KEY
#     STRIPE_SECRET_KEY   STRIPE_WEBHOOK_SECRET   STRIPE_PRICE_*
#
# A variable that is absent from BOTH this file and Coolify runs on the
# shipped default in the source, which is the correct answer for most of them
# -- see .env.example, which documents every switch this product has and why.
# Listed here are only the ones production sets deliberately.


# ── Where the work happens ───────────────────────────────────────────────────
# Seconds of finished video one credit buys. The planner divides the total
# between the scenes and floors each at 6s, caps it at 12s
# (interfaces/second_budget), so a number far above that cap does not buy a
# longer film. It read "100" for a long time, which no scene has ever been.
MUSEFORGE_SECONDS_PER_SCENE=10

# Angles per scene. Each one is a SEPARATE flat-rate generation on the current
# backend, so this is a spending decision: 2 puts a 12-second scene at $1.44
# instead of $0.72. It becomes free only when the video backend cuts inside one
# generation (MUSEFORGE_VIDEO_PROVIDER below).
MUSEFORGE_SHOTS_PER_SCENE=2

# Long Pro jobs need generous bounds. Generation runs as a background task
# after /api/generate returns, so an HTTP request timeout does not apply to the
# job itself -- these are in-process guards. Both match the source defaults;
# they are written down so a change is visible rather than silent.
MUSEFORGE_PIPELINE_HARD_TIMEOUT=7200
MUSEFORGE_STALE_JOB_TIMEOUT_MINUTES=150


# ── Sound ────────────────────────────────────────────────────────────────────
# Spoken dialogue. /api/health reports `dialogue_available` from this and the
# client only offers the Pro toggle when it is true, so a deployment that
# leaves it off sells a feature it will not display. The per-job opt-in still
# sits behind that toggle: this decides whether the product can be ASKED.
MUSEFORGE_DIALOGUE_ENABLED=1

# Lip sync. Readiness, not spending -- the opt-in still charges +1 credit per
# speaking scene. It must not be on while DIALOGUE_ENABLED is off: sync has
# nothing to drive a mouth from without a generated voice, and that pairing
# shipped dramas with the voice laid over closed mouths.
MUSEFORGE_LIPSYNC_ENABLED=1

# Voices direct from ElevenLabs rather than through a reseller: valid voices
# can be QUERIED, per-line timings come back measured, and those timings are
# what MUSEFORGE_WORD_CAPTIONS below needs.
MUSEFORGE_VOICE_PROVIDER=elevenlabs

# Foley, one bed per scene, a cent a scene. Left off, a job with music disabled
# ships a master that is mostly digital silence and the speech reads as pasted
# over the picture because there is nothing underneath it.
MUSEFORGE_FOLEY=1
MUAPI_MUSIC_MODEL=suno-create-music


# ── Picture ──────────────────────────────────────────────────────────────────
# A Claude-vision check that the frame holds the character and the setting it
# was asked for, with ONE targeted repair, run BEFORE the shot is animated. The
# arithmetic is the argument: a frame costs $0.04 and the generation that
# follows it costs $0.72. Shipped off, a delivered job spent $4.32 of video on
# six frames nothing had looked at.
MUSEFORGE_CHARACTER_QA_ENABLED=1

# A second angle on the scenes that earn it (tension 8+): a cutaway on the
# listening face. It REPLACES the second designed angle rather than adding to
# it, and routes to veo3.1-lite ($0.30 flat) instead of Kling ($0.72) -- so
# with MUSEFORGE_SHOTS_PER_SCENE=2 above it makes a peak scene CHEAPER, and it
# is the only lever that improves coverage on the current backend.
MUSEFORGE_REACTION_SHOTS=1

# The reference model a character-locked frame is drawn from. flux-pulid reads
# ONE image by construction, so in a two-hander the other face is drawn from
# the prompt's prose -- and prose produces somebody who matches the description
# and is not the same person twice. Switching to flux-kontext-pro-i2i hands the
# model the whole set; see .env.example for what has to be confirmed first.
MUAPI_KONTEXT_MODEL=flux-pulid

# Empty is "muapi" and is the shipped path. Named here because it was once set
# to "falai" in a developer's .env and nowhere else, so what was tested locally
# was not what production rendered -- and the two do not share a schema.
MUSEFORGE_IMAGE_PROVIDER=


# ── Delivery ─────────────────────────────────────────────────────────────────
# Kinetic word-by-word captions. Needs the ElevenLabs voice path above for
# measured word timings; on any other voice backend it silently does nothing,
# which is why the two are set together.
MUSEFORGE_WORD_CAPTIONS=1

# Opens on the shock, refuses to resolve, and puts a cold-open teaser in front
# of the film. Selectable per job via the API's `narrative_mode`, which
# outranks this.
MUSEFORGE_NARRATIVE_MODE=micro_drama

MUSEFORGE_LOG_LEVEL=INFO
ALLOWED_ORIGINS=https://museforge.studio,https://www.museforge.studio,https://api2.museforge.studio


# ── Deliberately unset ───────────────────────────────────────────────────────
# Present as a note, not as configuration. Each of these runs on the source
# default; .env.example carries the full argument for every one.
#
#   MUSEFORGE_LETTERBOX          2.39:1 matte. OFF unless this deployment
#                                delivers 16:9 ONLY -- the bars are burned into
#                                the master, so a 9:16 or 1:1 re-export would
#                                centre-crop a frame that already has them.
#   MUSEFORGE_CHARACTER_SHEET    Four-view character lock. Pair it WITH a
#                                reference model that combines views; pulid
#                                expects a face photograph and a grid is not
#                                one.
#   MUSEFORGE_VIDEO_PROVIDER     "falai_multishot" renders a whole scene per
#                                generation with its cuts inside it, speaks its
#                                own dialogue, and drops the lip-sync pass --
#                                329s of a delivered 918s render. Not yet run
#                                against a live provider.
#   MUSEFORGE_ACTING_END_FRAME   Acted end frames (+~$0.03 a shot).
#   MUSEFORGE_TARGET_FPS         Empty keeps the provider's own frame rate.
#   MUSEFORGE_SPEAKER_LABELS     SDH-style speaker names in subtitles.
#   MUSEFORGE_DEMO               Never set in production.
